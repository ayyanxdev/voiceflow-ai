# VoiceFlow AI — Environment Variables
# Copy to .env and fill in values

# App
APP_ENV=development
DEBUG=true

# Security
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=sqlite:///./voiceflow.db

# Retell AI (optional — leave empty for demo mode)
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_WEBHOOK_SECRET=

# Vapi AI (optional — leave empty for demo mode)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEETS_ID=

# AI Providers (optional — leave empty for mock mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CLAUDE_API_KEY=

# Integrations (optional)
CRM_API_KEY=
CRM_WEBHOOK_URL=
SMS_API_KEY=
SMS_FROM_NUMBER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
