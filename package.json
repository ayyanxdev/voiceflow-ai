{
  "name": "voiceflow-ai",
  "version": "1.0.0",
  "description": "AI Voice Sales & Receptionist Automation Platform",
  "private": true,
  "scripts": {
    "setup": "bash setup.sh",
    "dev": "concurrently \"cd backend && uvicorn app.main:app --reload\" \"cd frontend && npm run dev\"",
    "dev:backend": "cd backend && uvicorn app.main:app --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test": "cd backend && python -m pytest tests/ -v",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
